{
  "title": "cdxgen roadmap",
  "owner": "cdxgen",
  "public": true,
  "shortDescription": "Roadmap and work tracking for the cdxgen organization. See https://github.com/cdxgen/.github/tree/main/project",
  "repositories": [
    "cdxgen/cdxgen"
  ],
  "fields": [
    {
      "name": "Status",
      "builtin": true,
      "options": [
        {
          "name": "Triage",
          "color": "GRAY",
          "description": "New, not yet looked at by a maintainer"
        },
        {
          "name": "Backlog",
          "color": "PURPLE",
          "description": "Accepted, not scheduled"
        },
        {
          "name": "Ready",
          "color": "BLUE",
          "description": "Scoped well enough for a person or an agent to start"
        },
        {
          "name": "In progress",
          "color": "YELLOW",
          "description": "Someone is working on it, or a draft pull request is open"
        },
        {
          "name": "In review",
          "color": "ORANGE",
          "description": "A pull request is open and ready for review"
        },
        {
          "name": "Blocked",
          "color": "RED",
          "description": "Waiting on something outside the work itself"
        },
        {
          "name": "Done",
          "color": "GREEN",
          "description": "Merged, or closed"
        }
      ]
    },
    {
      "name": "Horizon",
      "options": [
        {
          "name": "Now",
          "color": "GREEN",
          "description": "Being worked on this release cycle"
        },
        {
          "name": "Next",
          "color": "BLUE",
          "description": "Planned for the following cycle"
        },
        {
          "name": "Later",
          "color": "GRAY",
          "description": "Wanted, with no schedule"
        }
      ]
    },
    {
      "name": "Priority",
      "options": [
        {
          "name": "P0",
          "color": "RED",
          "description": "Broken output or a security problem for many users"
        },
        {
          "name": "P1",
          "color": "ORANGE",
          "description": "Important for the next release"
        },
        {
          "name": "P2",
          "color": "GRAY",
          "description": "Worth doing when time allows"
        }
      ]
    },
    {
      "name": "Area",
      "options": [
        {
          "name": "JavaScript",
          "color": "YELLOW"
        },
        {
          "name": "Python",
          "color": "BLUE"
        },
        {
          "name": "Java",
          "color": "ORANGE"
        },
        {
          "name": "Go",
          "color": "BLUE"
        },
        {
          "name": "Rust",
          "color": "ORANGE"
        },
        {
          "name": ".NET",
          "color": "PURPLE"
        },
        {
          "name": "Ruby",
          "color": "RED"
        },
        {
          "name": "Swift",
          "color": "ORANGE"
        },
        {
          "name": "C and C++",
          "color": "GRAY"
        },
        {
          "name": "Containers",
          "color": "BLUE"
        },
        {
          "name": "Evinse",
          "color": "PURPLE"
        },
        {
          "name": "CBOM",
          "color": "GREEN"
        },
        {
          "name": "AI-BOM",
          "color": "PINK"
        },
        {
          "name": "Integrations",
          "color": "GREEN"
        },
        {
          "name": "Build and CI",
          "color": "GRAY"
        },
        {
          "name": "Documentation",
          "color": "GRAY"
        },
        {
          "name": "Security",
          "color": "RED"
        }
      ]
    },
    {
      "name": "Plan",
      "dataType": "TEXT"
    }
  ],
  "labelFields": [
    {
      "field": "Area",
      "map": {
        "lang:node": "JavaScript",
        "lang:python": "Python",
        "lang:java": "Java",
        "lang:go": "Go",
        "lang:rust": "Rust",
        "lang:dotnet": ".NET",
        "lang:ruby": "Ruby",
        "lang:swift": "Swift",
        "lang:c": "C and C++",
        "lang:container": "Containers",
        "evinse": "Evinse",
        "cbom": "CBOM",
        "aibom": "AI-BOM",
        "intg:dtrack": "Integrations",
        "build": "Build and CI",
        "infra": "Build and CI",
        "documentation": "Documentation",
        "security": "Security"
      }
    }
  ],
  "labels": [
    {
      "name": "blocked",
      "color": "B60205",
      "description": "Waiting on something outside the work itself"
    },
    {
      "name": "needs-decision",
      "color": "FBCA04",
      "description": "A maintainer has to choose before work can continue"
    },
    {
      "name": "needs triaging",
      "color": "FDBC58",
      "description": "A maintainer has not looked at this yet"
    }
  ],
  "views": [
    {
      "name": "Status",
      "layout": "BOARD_LAYOUT",
      "filter": "-status:Done",
      "note": "Columns by Status."
    },
    {
      "name": "Horizon",
      "layout": "BOARD_LAYOUT",
      "filter": "-status:Done",
      "note": "Set the column field to Horizon."
    },
    {
      "name": "13.6.0",
      "layout": "BOARD_LAYOUT",
      "filter": "milestone:\"13.6.0\"",
      "note": "Columns by Status. Change the filter to the next release's milestone when it ships."
    },
    {
      "name": "Triage",
      "layout": "TABLE_LAYOUT",
      "filter": "status:Triage",
      "note": "",
      "columns": [
        "Title",
        "Labels",
        "Area",
        "Repository"
      ]
    },
    {
      "name": "Releases",
      "layout": "TABLE_LAYOUT",
      "filter": "-status:Done",
      "note": "Group by Milestone.",
      "columns": [
        "Title",
        "Status",
        "Priority",
        "Area",
        "Milestone",
        "Linked pull requests"
      ]
    },
    {
      "name": "Agent queue",
      "layout": "TABLE_LAYOUT",
      "filter": "status:\"In progress\",\"In review\" -label:\"needs triaging\"",
      "note": "Work that is being done or waiting for review. Group by Status and sort by Priority.",
      "columns": [
        "Title",
        "Status",
        "Priority",
        "Milestone",
        "Area",
        "Linked pull requests"
      ]
    },
    {
      "name": "Needs a person",
      "layout": "TABLE_LAYOUT",
      "filter": "-status:Done label:blocked,needs-decision",
      "note": "",
      "columns": [
        "Title",
        "Status",
        "Labels",
        "Assignees",
        "Priority"
      ]
    },
    {
      "name": "Epics",
      "layout": "TABLE_LAYOUT",
      "filter": "type:Epic",
      "note": "Group by Status.",
      "columns": [
        "Title",
        "Status",
        "Horizon",
        "Plan",
        "Sub-issues progress"
      ]
    }
  ],
  "issueTypes": [
    {
      "name": "Epic",
      "description": "A planned body of work with a plan document and several deliverables",
      "color": "purple"
    }
  ]
}
